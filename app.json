{
  "expo": {
    "name": "GreenCompass",
    "slug": "GreenCompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GCLogo-rich-premium-app-icon.png",
    "scheme": "com.act4zero.greencompass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.act4zero.greencompass"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/GCLogo-rich-premium-original-shape.png",
        "backgroundColor": "#07503F"
      },
      "package": "com.act4zero.greencompass"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/GCLogo-rich-premium-web.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GCLogo-rich-premium-original-shape.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "owner": "act4zero",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
