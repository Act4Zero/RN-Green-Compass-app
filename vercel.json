{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/map/$1",
      "has": [{ "host": "map.greencompass.app" }]
    },
    {
      "source": "/:path*",
      "destination": "/",
      "missing": [{ "host": "map.greencompass.app" }]
    }
  ]
}
